#!/sbin/sh
##########################################################################################
#
# POCO M5 Ultimate Audio Fix - Installer
# Compatible with Magisk and KernelSU / APatch
#
##########################################################################################

umask 022

OUTFD=$2
ZIPFILE=$3
[ -z "$OUTFD" ] && OUTFD=1

ui_print() { echo -e "ui_print $1\nui_print" >&"$OUTFD"; }
abort() { ui_print "$1"; exit 1; }

ui_print "***********************************"
ui_print "    POCO M5 Ultimate Audio Fix     "
ui_print "***********************************"

mount /data 2>/dev/null

if [ -f /data/adb/magisk/util_functions.sh ]; then
  # Real Magisk environment: source helper functions and let Magisk's
  # own install_module routine copy $MODPATH/system into place, set
  # SELinux contexts/permissions, and stage the module for next boot.
  . /data/adb/magisk/util_functions.sh
  [ "$MAGISK_VER_CODE" -lt 21000 ] && abort "! Please install Magisk v21.0+"

  ui_print "- Installing via Magisk..."
  install_module
  ui_print "- A boot-time check will confirm the actual mount result."
  ui_print "  After rebooting, verify with:"
  ui_print "    adb shell getprop poco.audiofix.status"
  ui_print "  or check /data/adb/poco_audio_fix_status.log"
  ui_print "- Done! Reboot to apply."
  exit 0
else
  # No Magisk present, so this is KernelSU / APatch. Those managers
  # extract module.prop and system/ natively (before this script ever
  # runs) as part of their own module install routine, so there is
  # nothing left for this script to do.
  #
  # NOTE: on KernelSU you must have a mounting metamodule installed
  # (e.g. meta-overlayfs, Magic Mount-rs, or Hybrid Mount) or the
  # system/vendor files in this module will not actually get mounted.
  ui_print "- Detected KernelSU / APatch."
  ui_print "- Files staged by manager; nothing else to do here."

  # KernelSU's documented convention: a metamodule identifies itself with
  # "metamodule=1" (or =true) in its own module.prop. Scan already-installed
  # modules for one so we can warn now instead of leaving the user guessing.
  METAMODULE_FOUND=false
  for prop in /data/adb/modules/*/module.prop; do
    [ -f "$prop" ] || continue
    if grep -Eq '^metamodule[[:space:]]*=[[:space:]]*(1|true)' "$prop" 2>/dev/null; then
      METAMODULE_FOUND=true
      break
    fi
  done

  if ! $METAMODULE_FOUND; then
    ui_print "! WARNING: no mount metamodule detected (meta-overlayfs,"
    ui_print "!          Hybrid Mount, Magic Mount-rs, etc)."
    ui_print "! Without one, KernelSU/APatch will NOT mount this module's"
    ui_print "! system/vendor files - the audio fix will not apply."
    ui_print "! Install a metamodule from KernelSU Manager -> Modules first,"
    ui_print "! then reinstall this module."
  else
    ui_print "- Metamodule detected, mounting should work after reboot."
  fi

  ui_print "- A boot-time check will confirm the actual mount result."
  ui_print "  After rebooting, verify with:"
  ui_print "    adb shell getprop poco.audiofix.status"
  ui_print "  or check /data/adb/poco_audio_fix_status.log"
  ui_print "- Done! Reboot to apply."
  exit 0
fi
